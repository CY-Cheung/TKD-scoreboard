    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.8.0",
    "gsap": "^3.13.0",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^3.11.174",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.3.0",
    "jsdom": "^25.0.1",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
